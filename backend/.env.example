# Copiar a backend/.env y completar. NO subir .env al repositorio.
DJANGO_DEBUG=1                 # 1 solo en desarrollo; en producción 0
DJANGO_SECRET_KEY=             # obligatoria en producción
GOOGLE_CLIENT_ID=
WHATSAPP_NUMERO=569XXXXXXXX
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
# Llave del planificador semanal de precios (mismo valor en el secreto CRON_TOKEN de GitHub)
CRON_TOKEN=
# Resumen con IA (Groq). Vacío = se usa el resumen base sin IA.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Clave compartida con el frontend (mismo valor en Vercel y Render); permite contar peticiones por la IP real del visitante.
PROXY_SECRET=
# Zonas de la CNE para el precio del combustible (por defecto Zona Centro,Zona Sur)
COMBUSTIBLE_ZONAS=Zona Centro,Zona Sur
